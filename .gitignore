# IDE and editor-specific files
.zed/
.vs/
.vscode/
*.code-workspace

# Local language-server configuration
.clangd

# Local generated build metadata
.build/
compile_commands.json

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig
Makefile

# Source art intentionally excluded
SourceArt/**/*.png
SourceArt/**/*.tga

# Unreal binary outputs
Binaries/
Plugins/**/Binaries/

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Unreal editor-generated data
Content/Developers/
Saved/

# Unreal build intermediates
Intermediate/
Plugins/**/Intermediate/

# Unreal derived data cache
DerivedDataCache/
